# Copy to .env to override defaults. Everything here is optional.
# docs/HOSTING.md has the full list.

# Leave DATABASE_URL unset to use backend/logbook.db (SQLite).
# PostgreSQL (psycopg is already in requirements.txt), e.g. a Neon database:
# DATABASE_URL=postgresql://user:password@host/logbook?sslmode=require

# Turn on accounts (do this for any server other people can reach).
# You log in as LOGBOOK_ADMIN_USERNAME with LOGBOOK_PASSWORD; friends join with invites.
# LOGBOOK_PASSWORD=a long password
# LOGBOOK_ADMIN_USERNAME=kal
# LOGBOOK_MAX_USERS=10
# LOGBOOK_AI_FOR_EVERYONE=false   # true lets invited accounts use the AI key below (you pay)
# LOGBOOK_TRUST_PROXY=true        # only behind a proxy that sets X-Forwarded-For (on by default on Render)

# AI for every device, with the key kept on this server (Anthropic by default):
# LOGBOOK_AI_API_KEY=sk-ant-...
# or a local model with Ollama:
# LOGBOOK_AI_PROVIDER=openai
# LOGBOOK_AI_BASE_URL=http://localhost:11434/v1
# LOGBOOK_AI_MODEL=llama3.2
